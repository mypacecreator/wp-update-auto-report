{
	"name": "mypacecreator/wp-update-auto-report",
	"description": "WordPress auto update report generator with Anthropic AI integration",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "mypacecreator",
			"homepage": "https://github.com/mypacecreator"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^1.10",
		"phpunit/phpunit": "^10.0"
	},
	"autoload": {
		"psr-4": {
			"WP_Update_Auto_Report\\": "includes/"
		}
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/anthropics/anthropic-sdk-php.git"
		}
	],
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		}
	}
}
